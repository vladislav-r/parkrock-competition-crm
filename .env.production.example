# Домен без протокола. DNS A-запись должна указывать на IPv4 VPS.
DOMAIN=results.example.ru
# Публичный лендинг, который отправляет заявки в CRM. HTTP оставлен временно,
# пока на хостинге лендинга не выпущен сертификат и не включён редирект на HTTPS.
LANDING_ORIGINS=https://fest.parkrock27.ru,http://fest.parkrock27.ru

POSTGRES_DB=climbhub
POSTGRES_USER=climbhub
# Используйте длинное URL-безопасное значение без символов @ : / %.
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Не менее 32 случайных байт. Не используйте тестовое значение из dev-среды.
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Отдельная учётная запись для панели https://DOMAIN/monitoring/.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-long-random-password

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
BACKUP_MAX_UPLOAD_MB=2048

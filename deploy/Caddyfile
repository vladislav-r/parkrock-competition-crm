{$DOMAIN} {
	encode zstd gzip

	@backend path /api/* /health /docs* /openapi.json
	reverse_proxy @backend backend:8001
	reverse_proxy frontend:3000

	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}

	log {
		output stdout
		format console
	}
}
